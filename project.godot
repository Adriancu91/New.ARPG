; Engine configuration file.
; GLOAMREACH — Oath of the Ashen Vigil (internal working title)

config_version=5

[application]

config/name="Gloamreach"
config/description="Offline single-player dark-fantasy action RPG."
config/version="0.1.0"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/bg_color=Color(0.03, 0.025, 0.04, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.svg"

[autoload]

InputSetup="*res://systems/core/input_setup.gd"
Events="*res://systems/core/events.gd"
DB="*res://systems/core/database.gd"
Game="*res://systems/core/game_state.gd"
SaveSystem="*res://systems/save/save_system.gd"
Audio="*res://systems/audio/audio_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=24.0

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="pickup"
3d_physics/layer_5="interactable"
3d_physics/layer_6="projectile"

[rendering]

anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.03, 0.025, 0.04, 1)
lights_and_shadows/directional_shadow/size=2048
textures/canvas_textures/default_texture_filter=1
